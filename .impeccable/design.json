      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:7px 11px;border:1px solid var(--line,#42494f);border-radius:8px;background:#2b3136;color:inherit;cursor:pointer;font-weight:500;line-height:1.3}.ds-button:active:not(:disabled){background:#454d54}.ds-button:disabled{opacity:.5;cursor:default}.ds-button[aria-pressed=true]{background:#3b454e;color:#fff}.ds-button{font-family:Medeo,'Segoe UI',sans-serif;font-size:14px;color:#f2f4f5;outline-offset:3px}.ds-button:focus-visible{outline:2px solid var(--accent,#b6c3d0)}@media(hover:hover) and (pointer:fine){.ds-button:hover:not(:disabled){background:#3a4249}}.ds-tool{display:flex;flex-direction:column;gap:9px;padding:11px 3px;border:0;border-radius:10px;background:var(--surface,#22272b);min-height:70px;min-width:0;font-size:12px}.ds-tool span{max-width:100%;overflow-wrap:anywhere}@media(hover:hover) and (pointer:fine){.ds-tool:hover:not(:disabled){background:#343c43}}"
