    <Compile Include="../../src/SideWidget.App/CoreAudioInterop.cs" Link="Services/CoreAudioInterop.cs" />
    <Compile Include="../../src/SideWidget.App/EverythingService.cs" Link="Services/EverythingService.cs" />
